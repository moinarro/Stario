<com.stario.launcher.ui.common.FadingEdgeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:edge="top|bottom"
    app:size_bottom="20dp"
    app:size_top="20dp">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:fontFamily="@font/dm_sans_regular"
                android:text="@string/dashboard_settings_description"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/dm_sans_medium"
                android:letterSpacing="-0.03"
                android:text="@string/dashboard_pages"
                android:textColor="?attr/colorOnSurface"
                android:textSize="18sp" />

            <carbon.widget.RelativeLayout
                android:id="@+id/page_home_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ripple"
                android:padding="7dp"
                app:carbon_cornerRadius="20dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/page_home"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:drawableStart="@drawable/ic_dashboard"
                    android:drawablePadding="10dp"
                    android:fontFamily="@font/dm_sans_medium"
                    android:letterSpacing="-0.03"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/dashboard_home"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="20sp" />

            </carbon.widget.RelativeLayout>

            <Space
                android:layout_width="0px"
                android:layout_height="10dp" />

            <carbon.widget.RelativeLayout
                android:id="@+id/page_media_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ripple"
                android:padding="7dp"
                app:carbon_cornerRadius="20dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/page_media"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:drawableStart="@drawable/ic_media_play"
                    android:drawablePadding="10dp"
                    android:fontFamily="@font/dm_sans_medium"
                    android:letterSpacing="-0.03"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/dashboard_media"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="20sp" />

            </carbon.widget.RelativeLayout>

            <Space
                android:layout_width="0px"
                android:layout_height="10dp" />

            <carbon.widget.RelativeLayout
                android:id="@+id/page_utilities_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ripple"
                android:padding="7dp"
                app:carbon_cornerRadius="20dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/page_utilities"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:drawableStart="@drawable/ic_usage_stats"
                    android:drawablePadding="10dp"
                    android:fontFamily="@font/dm_sans_medium"
                    android:letterSpacing="-0.03"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/dashboard_utilities"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="20sp" />

            </carbon.widget.RelativeLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/dm_sans_medium"
                android:letterSpacing="-0.03"
                android:text="@string/dashboard_default_page"
                android:textColor="?attr/colorOnSurface"
                android:textSize="18sp" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/default_page"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <Button
                    android:id="@+id/default_page_home"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/dm_sans_regular"
                    android:text="@string/dashboard_home"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/default_page_media"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/dm_sans_regular"
                    android:text="@string/dashboard_media"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/default_page_utilities"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/dm_sans_regular"
                    android:text="@string/dashboard_utilities"
                    android:textSize="14sp" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</com.stario.launcher.ui.common.FadingEdgeLayout>
