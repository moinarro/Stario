<carbon.widget.LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="20dp"
    android:paddingTop="20dp"
    android:paddingRight="20dp"
    android:paddingBottom="20dp"
    app:carbon_maxHeight="560dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginBottom="10dp"
        android:fontFamily="@font/dm_sans_regular"
        android:text="@string/widget_schedule_description"
        android:textColor="?attr/colorSecondary"
        android:textSize="16sp" />

    <carbon.widget.RelativeLayout
        android:id="@+id/enabled_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp"
        android:background="@drawable/ripple"
        android:padding="7dp"
        app:carbon_cornerRadius="20dp">

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:drawableStart="@drawable/ic_watch"
            android:drawablePadding="10dp"
            android:fontFamily="@font/dm_sans_medium"
            android:letterSpacing="-0.03"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/widget_schedule_enabled"
            android:textColor="?attr/colorOnSurface"
            android:textSize="20sp" />

    </carbon.widget.RelativeLayout>

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginBottom="10dp"
        android:fontFamily="@font/dm_sans_regular"
        android:text="@string/widget_schedule_empty"
        android:textColor="?attr/colorOnSurface"
        android:textSize="16sp"
        android:visibility="gone" />

    <carbon.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp"
        android:nestedScrollingEnabled="true"
        android:overScrollMode="never"
        app:carbon_cornerRadius="20dp"
        app:carbon_overScroll="never" />

    <carbon.widget.RelativeLayout
        android:id="@+id/add_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/ripple"
        android:padding="7dp"
        app:carbon_cornerRadius="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_add"
            android:drawablePadding="10dp"
            android:fontFamily="@font/dm_sans_medium"
            android:gravity="center_vertical"
            android:letterSpacing="-0.03"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:text="@string/widget_schedule_add"
            android:textColor="?attr/colorOnSurface"
            android:textSize="20sp" />

    </carbon.widget.RelativeLayout>

</carbon.widget.LinearLayout>
